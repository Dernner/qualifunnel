# .env.development — Qualifunnel variáveis de ambiente para desenvolvimento local
# ⚠️ NUNCA commitar este arquivo com valores reais de produção
# Copie para .env e ajuste conforme necessário

# ─── Rails ─────────────────────────────────────────────────────
SECRET_KEY_BASE=qualifunnel_dev_secret_key_base_change_this_in_production
RAILS_ENV=development
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://qualifunnel:qualifunnel_dev@postgres:5432/qualifunnel_development

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── URLs ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
FORCE_SSL=false

# ─── Email (MailHog local) ──────────────────────────────────────
MAILER_SENDER_EMAIL=hello@qualifunnel.local
SMTP_ADDRESS=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_OPENSSL_VERIFY_MODE=none

# ─── Storage ───────────────────────────────────────────────────
ACTIVE_STORAGE_SERVICE=local

# ─── Vite ──────────────────────────────────────────────────────
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_PORT=3036

# ─── Feature: desabilitar engines externas se quiser ───────────
# DISABLE_ENTERPRISE=true
# DISABLE_QUALIFUNNEL=false

# ─── Logs ──────────────────────────────────────────────────────
RAILS_LOG_TO_STDOUT=true
